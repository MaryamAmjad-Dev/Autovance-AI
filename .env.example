# Autovance AI — environment configuration template.
#
# Copy this file to `.env.local` and fill in real values.
# `.env*` is git-ignored except this template, so real secrets can never be
# committed. Never paste live API keys into this file.

# -----------------------------------------------------------------------------
# AI provider (needed for: dashboard generator, /email draft generation,
# /form AI assist, and the Workflow Builder research prototype at /workflows)
# -----------------------------------------------------------------------------
# Server-side key from https://openrouter.ai/keys . Read only on the server;
# it is never sent to the browser and never logged.
OPENROUTER_API_KEY=your-openrouter-api-key

# Model slug requested from OpenRouter. Free-tier models (`:free`) can return
# HTTP 429 when the shared capacity pool is exhausted; the app reports that
# failure honestly instead of pretending generation succeeded.
AI_MODEL=google/gemma-4-31b-it:free

# -----------------------------------------------------------------------------
# Email sending (Email Automation, /email and password-reset emails)
# -----------------------------------------------------------------------------
# Configure exactly ONE provider plus a verified sender identity.
# Without these, sending is disabled and the UI/API report "not configured"
# naming the missing variables. Nothing is ever pretend-sent.
# Precedence when several keys are set: BREVO > RESEND > SENDGRID.
# Brevo (app.brevo.com → Settings → SMTP & API → API keys). The sender in
# EMAIL_FROM must be verified under app.brevo.com → Senders.
BREVO_API_KEY=your_brevo_api_key
# - or -
RESEND_API_KEY=re_your_resend_key
# - or -
SENDGRID_API_KEY=SG.your_sendgrid_key
EMAIL_FROM="Autovance AI <no-reply@yourdomain.com>"

# -----------------------------------------------------------------------------
# Form Actions follow-up (optional)
# -----------------------------------------------------------------------------
# A public http(s) URL that receives stored submissions as JSON.
# Leave unset for storage-only behaviour; the form UI states this honestly.
FORM_FOLLOWUP_WEBHOOK_URL=https://example.com/hooks/autovance

# -----------------------------------------------------------------------------
# Application base URL (required for password-reset emails in production)
# -----------------------------------------------------------------------------
# Public URL of the deployment, used to build links inside reset emails.
# In development (NODE_ENV != production) the request host is used instead.
# In production, if this is unset, reset requests fail with an explicit
# "not configured" message rather than trusting client-influenced headers.
APP_BASE_URL=http://localhost:3000
